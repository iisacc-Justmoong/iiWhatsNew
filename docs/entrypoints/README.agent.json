    {
      "id": "b000037",
      "kind": "paragraph",
      "start_line": 51,
      "end_line": 51,
      "raw": "Self-written code and documents of iiWhatsNew are distributed under the MIT License. The full terms follow [LICENSE](LICENSE).\n"
    },
    {
      "id": "b000038",
      "kind": "blank",
      "start_line": 52,
      "end_line": 52,
      "raw": "\n"
    },
    {
      "id": "b000039",
      "kind": "paragraph",
      "start_line": 53,
      "end_line": 53,
      "raw": "External libraries including Qt and third-party code with separate notices maintain their own licenses. This project's license declaration does not replace the corresponding third-party license.\n"
    },
    {
      "id": "b000040",
      "kind": "blank",
      "start_line": 54,
      "end_line": 54,
      "raw": "\n"
    },
    {
      "id": "b000041",
      "kind": "heading",
      "start_line": 55,
      "end_line": 55,
      "raw": "## Source layout\n",
      "level": 2,
      "title": "Source layout"
    },
    {
      "id": "b000042",
      "kind": "blank",
      "start_line": 56,
      "end_line": 56,
      "raw": "\n"
    },
    {
      "id": "b000043",
      "kind": "paragraph",
      "start_line": 57,
      "end_line": 57,
      "raw": "Implementation files and their headers live together under `src/`. Existing feature and platform subdirectories retain their responsibilities. Build configuration, tests, documentation, resources, and maintenance scripts remain at the project root. Configure and build using the repository-local `build/` directory.\n"
    },
    {
      "id": "b000044",
      "kind": "blank",
      "start_line": 58,
      "end_line": 58,
      "raw": "\n"
    },
